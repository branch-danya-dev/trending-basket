# Copy this file to .env and adjust as needed. .env is git-ignored.

TB_MODE=research
TB_DATA_DIR=./data
TB_REPORTS_DIR=./reports
TB_LOG_LEVEL=INFO

# Bybit public REST API (no key needed for market data).
TB_BYBIT_REST_URL=https://api.bybit.com
TB_REST_TIMEOUT_S=10.0
TB_REST_MIN_INTERVAL_S=0.2
TB_REST_MAX_RETRIES=6

# Bybit API keys: trade-only permission, no withdrawal, IP-restricted.
# TB_BYBIT_API_KEY=
# TB_BYBIT_API_SECRET=
