# Copy this file to .env and adjust as needed. .env is git-ignored.

TB_MODE=research
TB_DATA_DIR=./data
TB_REPORTS_DIR=./reports
TB_LOG_LEVEL=INFO

# Bybit public REST API (no key needed for market data).
TB_BYBIT_REST_URL=https://api.bybit.com
TB_REST_TIMEOUT_S=10.0
TB_REST_MIN_INTERVAL_S=0.2
TB_REST_MAX_RETRIES=6

# Bybit API keys: trading permission, no withdrawal; IP binding is optional for Demo.
# TB_BYBIT_API_KEY=
# TB_BYBIT_API_SECRET=

# T006a: private execution requires TB_MODE=demo and this exact host.
TB_BYBIT_DEMO_REST_URL=https://api-demo.bybit.com
TB_DEMO_RISK_FILE=docs/reports/T006-risk-level.json
# TB_TELEGRAM_BOT_TOKEN=
# TB_TELEGRAM_CHAT_ID=
